# Paths left out of the installable zip (bin/build-zip: git archive HEAD, then rsync --exclude-from).
# Everything else tracked in git ships: wp-divi-mcp.php, readme.txt, includes/, knowledge/, assets/.
/.distignore
/.git*
/.github/
/.superpowers/
/.wp-env*
/.phpunit.result.cache
/bin/
/build/
/composer.json
/composer.lock
/docs/
/node_modules/
/package.json
/package-lock.json
/phpunit.xml.dist
/README.md
/tests/
/tools/
/vendor/
