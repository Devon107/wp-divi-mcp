#!/usr/bin/env bash
# Run PHPUnit inside the wp-env tests container.
# Usage: bin/test [phpunit args]            e.g. bin/test --testsuite unit
# Divi-dependent tests (group "divi") are excluded unless WPDM_TEST_DIVI=1, Yoast ones (group
# "yoast") unless WPDM_TEST_YOAST=1, Polylang and WPML-double ones (groups "polylang" and
# "wpml") unless WPDM_TEST_POLYLANG=1. Divi tests need the Divi theme mapped via
# .wp-env.override.json.
# WP_MULTISITE=1 bin/test runs as multisite (multisite-only tests skip otherwise).
set -euo pipefail
cd "$(dirname "$0")/.."

env_args=(env)
excluded=()
if [ "${WPDM_TEST_DIVI:-}" = "1" ]; then
	env_args+=(WPDM_TEST_DIVI=1)
else
	excluded+=(divi)
fi
# Yoast SEO tests (group "yoast") need WPDM_TEST_YOAST=1; Yoast is installed in the
# tests env by .wp-env.json and only loaded when this is set.
if [ "${WPDM_TEST_YOAST:-}" = "1" ]; then
	env_args+=(WPDM_TEST_YOAST=1)
else
	excluded+=(yoast)
fi
# Language adapter tests: Polylang is installed in the tests env by .wp-env.json and only loaded
# when WPDM_TEST_POLYLANG=1. The WPML test double needs no plugin, so group "wpml" shares the flag.
if [ "${WPDM_TEST_POLYLANG:-}" = "1" ]; then
	env_args+=(WPDM_TEST_POLYLANG=1)
else
	excluded+=(polylang wpml)
fi
group_args=()
if [ "${#excluded[@]}" -gt 0 ]; then
	group_args=(--exclude-group "$(IFS=,; echo "${excluded[*]}")")
fi
# WP_MULTISITE=1 runs the suite as multisite (the WP test bootstrap reads it).
if [ "${WP_MULTISITE:-}" = "1" ]; then
	env_args+=(WP_MULTISITE=1)
fi

exec npx wp-env run tests-cli --env-cwd=wp-content/plugins/wp-divi-mcp \
	"${env_args[@]}" vendor/bin/phpunit "${group_args[@]}" "$@"
